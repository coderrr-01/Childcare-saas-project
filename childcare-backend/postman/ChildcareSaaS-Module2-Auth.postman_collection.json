              "raw": "{{baseUrl}}/api/v1/organisations?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "organisations"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
