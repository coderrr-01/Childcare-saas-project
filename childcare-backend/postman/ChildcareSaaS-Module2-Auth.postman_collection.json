            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@penguinpeak.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
